{
  "version": 2,
  "builds": [
    {
      "src": "server/server.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "routes/**",
          "controllers/**",
          "models/**",
          "middlewares/**",
          "config/**",
          "services/**",
          "utils/**"
        ]
      }
    },
    {
      "src": "front/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    },
    {
      "src": "admin/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "build"
      }
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/server/server.js"
    },
    {
      "source": "/admin/(assets|images|static)/(.*)",
      "destination": "/admin/$1/$2"
    },
    {
      "source": "/admin/(.*)",
      "destination": "/admin/index.html"
    },
    {
      "source": "/(assets|images|static|favicon.ico|robots.txt)(.*)",
      "destination": "/front/$1$2"
    },
    {
      "source": "/((?!api|admin).*)",
      "destination": "/front/index.html"
    }
  ]
}

